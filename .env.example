APP_LOGIN=replace-with-a-random-login
APP_PASSWORD=replace-with-a-random-password
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 (keep these server-side; never prefix with PUBLIC_)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-r2-bucket
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_PRESIGN_TTL_SECONDS=900
